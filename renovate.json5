{
  // Renovate configuration for updating dependencies.

  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    // Use the best-practices preset. Adds options to pin dependencies.
    // https://docs.renovatebot.com/upgrade-best-practices/#whats-in-the-configbest-practices-preset
    "config:best-practices",

    // Update dependencies quarterly. This strikes a balance between keeping
    // dependencies up to date and avoiding too many PRs across many
    // repositories.
    "schedule:quarterly",

    // Add DCO sign-off
    ":gitSignOff",

    // Add Aqua present to allow updating CLI tools.
    // https://aquaproj.github.io/docs/guides/renovate/
    "github>aquaproj/aqua-renovate-config#2.13.0",

    // Update version numbers in Makefile.
    // https://docs.renovatebot.com/presets-customManagers/#custommanagersmakefileversions
    "customManagers:makefileVersions",

    // Update version numbers in Dockerfiles.
    // https://docs.renovatebot.com/presets-customManagers/#custommanagersdockerfileversions
    "customManagers:dockerfileVersions",
  ],
  // NOTE: Set the prHourlyLimit to 0 to disable the hourly limit. This is done
  // because we are using a schedule and the default hourly limit of 2
  // would cause Renovate to only create 2 PRs every cycle.
  // Similarly set prConcurrentLimit to 0 to disable the concurrent PR limit.
  prHourlyLimit: 0,
  prConcurrentLimit: 0,

  // Security alerts/updates.
  vulnerabilityAlerts: {
    enabled: true,
    // Explicitly set the schedule to "at any time" to ensure that security
    // update PRs are created as soon as possible.
    schedule: ["at any time"],
  },
  osvVulnerabilityAlerts: true,

  // Apply a dependency cooldown of 14 days. This helps to avoid issues with
  // compromised releases.
  // https://blog.yossarian.net/2025/11/21/We-should-all-be-using-dependency-cooldowns
  // https://docs.renovatebot.com/configuration-options/#minimumreleaseage
  minimumReleaseAge: "14 days",

  // internalChecksFilter suppress PR creation for dependencies that were
  // released within minimumReleaseAge.
  // strict: All pending releases will be filtered. PRs will be skipped unless a
  // non-pending version is available.
  // https://docs.renovatebot.com/configuration-options/#internalchecksfilter
  internalChecksFilter: "strict",

  // Enable the lock file maintenance feature to keep transitive dependencies up
  // to date.
  lockFileMaintenance: {
    enabled: true,
    // NOTE: Same as schedule:monthly preset. This is done because lock file
    //       maintenance will catch security updates in transitive dependencies.
    // TODO(github.com/ianlewis/repo-template/issues/570): Update schedule when
    // security updates for transitive dependencies is supported.
    schedule: ["* 0-3 1 * *"],
  },

  // Enable git submodule updates.
  "git-submodules": {
    enabled: true,
    // NOTE: Same as schedule:monthly preset. We do this more often than the
    //       default because we want to ensure that we get security updates.
    schedule: ["* 0-3 1 * *"],
  },

  // Create a new issue for each config warning. By default, Renovate re-opens
  // an existing issue which can be very old and is easily missed. Opening new
  // issues is more intuitive.
  configWarningReuseIssue: false,

  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: [
        "/(^|/|\\.)([Dd]ocker|[Cc]ontainer)file$/",
        "/(^|/)([Dd]ocker|[Cc]ontainer)file[^/]*$/",
      ],
      matchStrings: [
        "# renovate:( suite=(?<suite>.*?))? depName=(?<depName>.*?)?\\s(?:ENV|ARG) .*?_VERSION=[\"']?(?<currentValue>[^\"'\\s]+)[\"']?",
      ],
      registryUrlTemplate: "https://deb.debian.org/debian?suite={{#if suite }}{{suite}}{{else}}stable{{/if}}&components=main,contrib,non-free&binaryArch=amd64",
      datasourceTemplate: "deb",
    },
    {
      customType: "regex",
      managerFilePatterns: [
        "/(^|/|\\.)([Dd]ocker|[Cc]ontainer)file$/",
        "/(^|/)([Dd]ocker|[Cc]ontainer)file[^/]*$/",
      ],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: (lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: registryUrl=(?<registryUrl>[^\\s]+?))?\\s(?:ENV|ARG)\\s+[A-Za-z0-9_]+?_VERSION[ =][\"']?(?<currentValue>.+?)[\"']?\\s(?:ENV|ARG)\\s+[A-Za-z0-9_]+?_DIGEST[ =][\"']?(?<currentDigest>[^\"'\\s]+)[\"']?\\s",
      ],
    },
  ],

  // Group various ecosystem updates. Security updates are always separate.
  // As a general rule, we automatically merge minor and patch updates for
  // development dependencies since they should have minimal impact on the
  // repository. This could be extended to include other dependencies if they
  // are relatively low risk.
  packageRules: [
    {
      groupName: "aqua",
      matchUpdateTypes: ["minor", "patch"],
      matchFileNames: [".aqua.yaml", ".aqua-checksums.yaml"],

      automerge: true,
      platformAutomerge: true,
    },
    {
      groupName: "makefile",
      matchUpdateTypes: ["minor", "patch"],
      matchFileNames: ["**/Makefile", "**/*.mk"],

      automerge: true,
      platformAutomerge: true,
    },
    {
      groupName: "github-actions",
      matchManagers: ["github-actions"],
      matchPackageNames: ["!slsa-framework/slsa-github-generator"],
      matchUpdateTypes: ["minor", "patch"],
      pinDigests: true,

      automerge: true,
      platformAutomerge: true,
    },
    {
      groupName: "github-actions",
      matchManagers: ["github-actions"],
      matchPackageNames: ["slsa-framework/slsa-github-generator"],
      pinDigests: false,
    },
    {
      groupName: "python",
      matchManagers: ["pep621"],
      matchUpdateTypes: ["minor", "patch"],
      matchDepTypes: [
        "build-system.requires",
        "project.dependencies",
        "project.optional-dependencies",
        "requires-python",
      ],
    },
    // NOTE: dependency-groups (PEP 725) in pep621 are sometimes used to specify
    //       development dependencies. However, they sometimes also include
    //       non-development dependencies. Development dependencies are usually
    //       specified in a dependency-group named 'dev' so we check for that
    //       name.
    // See: https://docs.renovatebot.com/modules/manager/pep621/
    {
      groupName: "python",
      matchManagers: ["pep621"],
      matchUpdateTypes: ["minor", "patch"],
      matchDepTypes: ["dependency-groups"],
      matchJsonata: ["managerData.depGroup != 'dev'"],
    },
    {
      groupName: "python dev",
      matchManagers: ["pep621"],
      matchUpdateTypes: ["minor", "patch"],
      matchDepTypes: ["tool.pdm.dev-dependencies", "tool.uv.dev-dependencies"],

      automerge: true,
      platformAutomerge: true,
    },
    {
      groupName: "python dev",
      matchManagers: ["pep621"],
      matchUpdateTypes: ["minor", "patch"],
      matchDepTypes: ["dependency-groups"],
      matchJsonata: ["managerData.depGroup = 'dev'"],

      automerge: true,
      platformAutomerge: true,
    },
    {
      groupName: "python dev",
      matchManagers: ["pip_requirements"],
      matchUpdateTypes: ["minor", "patch"],
      matchFileNames: ["requirements-dev.txt"],

      automerge: true,
      platformAutomerge: true,
    },
    {
      groupName: "npm",
      matchManagers: ["npm"],
      matchDepTypes: ["dependencies"],
      matchUpdateTypes: ["minor", "patch"],
      schedule: ["at any time"],
    },
    {
      groupName: "npm dev",
      matchManagers: ["npm"],
      matchDepTypes: ["devDependencies"],
      matchUpdateTypes: ["minor", "patch"],

      automerge: true,
      platformAutomerge: true,
    },
    {
      groupName: "dockerfile",
      matchFileNames: ["/(^|/|\\.)([Dd]ocker|[Cc]ontainer)file$/"],
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      schedule: ["at any time"],
    },
  ],
}
